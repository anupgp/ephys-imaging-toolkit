# =============================================================================
# box_credentials.example.env — TEMPLATE for the Box credentials file
# =============================================================================
# Keep the REAL file OUTSIDE of any git repository, e.g.
#     ~/.config/ephys_imaging_data_loader/box_credentials
# and make it readable only by you:
#     chmod 600 ~/.config/ephys_imaging_data_loader/box_credentials
#
# The values come from the Box Developer Console (your app -> Configuration).
# =============================================================================
CLIENT_ID=paste-client-id-here
CLIENT_SECRET=paste-client-secret-here
# Folder where the login tokens (oauth_box_auth.json) are stored.
BOX_OAUTH_LOC=~/.config/ephys_imaging_data_loader/
